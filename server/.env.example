# Copy to .env — never commit .env
PORT=5000
NODE_ENV=development
MONGODB_URI=
JWT_SECRET=replace-with-a-long-random-string
# Canonical public domain (no trailing slash). Used for canonicals + sitemap.
SITE_URL=http://localhost:5173
# Comma-separated exact origins allowed by CORS
CORS_ORIGINS=http://localhost:5173
# Path to built client (served by Express in single-host deployments)
CLIENT_DIST=../client/dist
# Persistent upload directory (mount a persistent disk in production)
UPLOAD_DIR=./uploads
# Used only by `npm run seed` to create the first admin (change immediately)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
